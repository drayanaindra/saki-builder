{
  "env": {
    "COVERAGE_MIN": "80"
  },
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(npx tsc *)",
      "Bash(npx tsc)",
      "Bash(npx playwright *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(cd *)",
      "Bash(psql *)",
      "Bash(python3 -c *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(source *)",
      "Bash(rtk *)",
      "Bash(pytest *)",
      "Bash(grep *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(column *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "mcp__playwright",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sonar-gate-init.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Context was compacted. Re-read any active plan files ([task]-plan.md) and MEMORY.md to restore critical context.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dangerous-command-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/sonar-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/coverage-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/format-staged.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/indrayana/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/indrayana/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/build-completion-gate.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pickup-completion-gate.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/prd-review-completion-gate.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "data-engineering@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "saki-builder@saketek": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "saketek": {
      "source": {
        "source": "git",
        "url": "https://gitlab.com/drayanaindra/saki-builder.git"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
